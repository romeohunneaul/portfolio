# Ask (⌘K) — Vercel AI Gateway. Sur Vercel, l'OIDC suffit (rien à définir).
# En local : https://vercel.com/~/ai-gateway/api-keys puis copier ce fichier en .env.local
AI_GATEWAY_API_KEY=

# Analytics + traces Ask — projet PostHog EU (eu.posthog.com), mode cookieless activé dans ses réglages.
# Token public (phc_…), utilisé côté navigateur et côté serveur. Vide = rien n'est envoyé.
NEXT_PUBLIC_POSTHOG_TOKEN=

# Alerte Telegram à chaque question Ask : bot créé avec @BotFather, chat_id de la conversation avec lui.
# Vides = pas d'alerte.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
