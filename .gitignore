# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# content-collections
.content-collections

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Obsidian (le dossier content/ est ouvert comme vault)
.obsidian/

*storybook.log
storybook-static

# design-sync (Claude Design): build output, staged scripts, verification state
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.design-sync/*.log
.ds-sync/
ds-bundle/

# design-sync: declaration tree of the Notebook primitives (.design-sync/tsconfig.types.json)
dist/
